#!/bin/sh
echo ">>> Black Hand OS starting..."

# Essential pseudo-filesystems — must be mounted before SSH, PTY, or anything
# that needs a terminal. blackhand-init mounts proc/sys/dev/run/tmp but NOT
# devpts (required for SSH PTY allocation) or devshm.
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts -o gid=5,mode=620 2>/dev/null || true
mount -t tmpfs tmpfs /dev/shm 2>/dev/null || true

# Display init FIRST — before anything that can block (networking, udhcpc)
if [ -x /usr/bin/hyperpixel4-init ]; then
    /usr/bin/hyperpixel4-init
fi

# Disable console blanking on tty1 so the screen stays lit without keyboard input
printf "\033[9;0]" > /dev/tty1 2>/dev/null || true

# Network — foreground udhcpc so SSH always starts with a valid IP.
# hyperpixel4-init already ran above, so display is up during this wait.
# -b combined with & causes double-backgrounding (two competing udhcpc
# processes) which breaks reliable IP assignment.
/sbin/ifconfig lo 127.0.0.1 up
/sbin/ifconfig eth0 up 2>/dev/null
if [ -x /sbin/udhcpc ]; then
    /sbin/udhcpc -i eth0 -t 5 -A 3 -q
fi

# SSH (start immediately)
if [ -x /usr/sbin/dropbear ]; then
    mkdir -p /etc/dropbear
    /usr/sbin/dropbear -R
fi

# Now do slower things...
mkdir -p /data /boot
mkdir -p /data/voice-memos
mkdir -p /data/notes
mkdir -p /data/alarms
mkdir -p /data/contacts
mkdir -p /data/music
chmod -R 755 /data

# Mount boot partition
mount -t vfat /dev/mmcblk0p1 /boot 2>/dev/null || true

# Load audio drivers
modprobe snd_bcm2835 2>/dev/null || true
modprobe snd_usb_audio 2>/dev/null || true   # USB-C earphones / BT USB dongle

# Route BCM2835 audio to headphone jack (1=headphone, 2=HDMI, 0=auto)
amixer -q cset numid=3 1 2>/dev/null || true

# ── Detect USB audio card ────────────────────────────────────────────────
# /proc/asound/cardN/usbbus only exists for USB audio devices.
# Iterate cards 1-7; use the first USB one we find.
USB_CARD=""
for n in 1 2 3 4 5 6 7; do
    if [ -f "/proc/asound/card${n}/usbbus" ]; then
        USB_CARD=$n
        break
    fi
done
[ -z "$USB_CARD" ] && USB_CARD=1   # fallback: assume card 1

echo "audio: USB audio card = $USB_CARD"
echo "$USB_CARD" > /tmp/bh-audio-card

# ── Write /etc/asound.conf — route 'default' to the USB audio card ──────
# All apps (mpg123, out123, arecord, aplay) that use 'default' will
# automatically land on the right device regardless of card number.
# The plug layer handles sample-rate and channel conversion.
cat > /etc/asound.conf << AEOF
# Generated by rcS — USB audio card ${USB_CARD}
pcm.!default {
    type plug
    slave.pcm "hw:${USB_CARD},0"
}
ctl.!default {
    type hw
    card ${USB_CARD}
}
AEOF

# Set USB audio card volume to 100% (both Master and PCM controls)
amixer -q -c "$USB_CARD" sset Master 100% 2>/dev/null || true
amixer -q -c "$USB_CARD" sset PCM    100% 2>/dev/null || true
amixer -q -c "$USB_CARD" sset Speaker 100% 2>/dev/null || true

# ── Bluetooth ────────────────────────────────────────────────────────────

# Required directories:
#   /run/dbus          — D-Bus system bus socket (created by dbus-daemon)
#   /var/lib/dbus      — machine-id storage
#   /var/lib/bluetooth — paired device keys + link keys. MUST persist across
#                        reboots — without it pairing is lost every boot and
#                        previously bonded devices refuse to auto-reconnect.
#   /var/run           — parent for /var/run/sdp socket (bluetoothd --compat)
mkdir -p /run/dbus /var/lib/dbus /var/lib/bluetooth /var/run

# D-Bus requires a stable machine-id. Generate once and persist to /etc.
# Without /etc/machine-id, dbus-daemon starts but bluetoothd cannot
# register on the system bus: "Failed to read machine uuid".
dbus-uuidgen --ensure /etc/machine-id 2>/dev/null || true
# Some dbus versions look in /var/lib/dbus/ instead.
[ -f /var/lib/dbus/machine-id ] || cp /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null || true

# Start the D-Bus system bus.
dbus-daemon --system --fork 2>/dev/null || true
sleep 0.3

# Attach the BCM43455 Bluetooth chip via userspace btattach.
#
# WHY NOT krnbt=on:
# krnbt=on makes the kernel serdev driver probe BCM43455 at ~1.2s into boot,
# BEFORE the ext4 rootfs is mounted and accessible to the firmware loader.
# The driver calls request_firmware_direct() — one shot, no retry. It fails
# with "firmware Patch file not found" even though the file is on disk.
#
# WHY btattach works:
# rcS only runs after the rootfs is fully mounted, so /lib/firmware/brcm/
# is always readable when btattach sends the firmware to the chip.
#
# -B /dev/ttyAMA0 : PL011 UART wired internally to BCM43455 on Pi 4
# -P bcm          : Broadcom H4 protocol (handles firmware upload sequence)
# -S 3000000      : renegotiate to 3 Mbps after firmware loads (BCM default)
if [ -c /dev/ttyAMA0 ]; then
    btattach -B /dev/ttyAMA0 -P bcm -S 3000000 &
    echo "bluetooth: btattach started on /dev/ttyAMA0"
else
    echo "bluetooth: WARNING — /dev/ttyAMA0 not found, BT attach skipped"
fi

# Unblock the BT radio in case it is soft-blocked via rfkill.
echo 0 > /sys/class/rfkill/rfkill0/soft 2>/dev/null || true
rfkill unblock bluetooth 2>/dev/null || true

# Wait for hci0. btattach uploads firmware then registers hci0 — this
# takes about 2-3 seconds. Poll up to 8 seconds before giving up.
HCI_WAIT=0
until [ -e /sys/class/bluetooth/hci0 ] || [ $HCI_WAIT -ge 16 ]; do
    sleep 0.5
    HCI_WAIT=$((HCI_WAIT + 1))
done

if [ -e /sys/class/bluetooth/hci0 ]; then
    echo "bluetooth: hci0 ready (waited ${HCI_WAIT}x0.5s)"
else
    echo "bluetooth: WARNING — hci0 not found after 8s, BT disabled"
fi

# Locate bluetoothd. Buildroot installs to /usr/libexec/bluetooth/,
# not /usr/sbin/ — check both for portability.
BT_DAEMON=""
for p in /usr/libexec/bluetooth/bluetoothd /usr/sbin/bluetoothd; do
    [ -x "$p" ] && BT_DAEMON="$p" && break
done

if [ -n "$BT_DAEMON" ] && [ -e /sys/class/bluetooth/hci0 ]; then
    # --compat  : enables legacy SDP socket at /var/run/sdp. Required for
    #             bluez-alsa HFP profile — RFCOMM channel negotiation uses
    #             the SDP socket. Without it HFP audio never connects.
    # --noplugin=sap : suppresses "sap-server: Operation not permitted"
    #             log spam (SAP = SIM Access Profile, needs SIM hardware).
    "$BT_DAEMON" --compat --noplugin=sap &
    echo "bluetooth: bluetoothd started ($BT_DAEMON)"

    # Wait for bluetoothd to fully register on D-Bus BEFORE starting
    # bluealsa. bluealsa calls into org.bluez at startup — if bluetoothd
    # isn't registered yet, bluealsa exits silently and BT audio never works.
    # Poll up to 5 seconds.
    BT_DBUS_WAIT=0
    until dbus-send --system --print-reply \
              --dest=org.freedesktop.DBus \
              /org/freedesktop/DBus \
              org.freedesktop.DBus.ListNames 2>/dev/null | grep -q org.bluez \
          || [ $BT_DBUS_WAIT -ge 10 ]; do
        sleep 0.5
        BT_DBUS_WAIT=$((BT_DBUS_WAIT + 1))
    done
    echo "bluetooth: org.bluez on D-Bus (waited ${BT_DBUS_WAIT}x0.5s)"

    # Start bluez-alsa bridge.
    # Profile flags for a phone-style device:
    #   a2dp-source — Pi streams audio OUT to a BT speaker or headset
    #   a2dp-sink   — Pi receives audio IN from another device
    #   hfp-ag      — Pi is the Audio Gateway (= the phone side of a call).
    #                 NOTE: use hfp-ag NOT hfp-hf. hfp-hf is the headset /
    #                 car-kit role. This device IS the phone, so it's the AG.
    bluealsa -p a2dp-source -p a2dp-sink -p hfp-ag &
    sleep 0.3
    echo "bluetooth: bluealsa started"

    # Register a headless pairing agent ("Just Works" / NoInputNoOutput).
    # Without an agent, bluetoothd rejects ALL pairing attempts with
    # "No agent is registered". bt-agent is from the bluez-tools package.
    if command -v bt-agent >/dev/null 2>&1; then
        bt-agent -c NoInputNoOutput &
        echo "bluetooth: bt-agent started (Just Works pairing enabled)"
    else
        echo "bluetooth: WARNING — bt-agent not found (install bluez-tools)"
        echo "           Pairing will fail until an agent is registered."
    fi
else
    echo "bluetooth: ERROR — bluetoothd not found or hci0 missing, BT disabled"
fi

echo ">>> Black Hand OS ready"
echo "fb0: $(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null || echo 'not found')"



# Black Hand OS kernel config fragment for HyperPixel support
# Apply with BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES
#
# IMPORTANT: These are set to =y (built-in) to ensure they are always
# available at boot. The base bcm2711_defconfig sets many of these as
# =m (modules), but since we don't have an initramfs and need the
# display driver before rootfs modules load, built-in is required.

# ── Device Tree Overlays ──
# CRITICAL: Without these, the base DTB has no __symbols__ section
# and the firmware CANNOT apply any dtoverlay= entries from config.txt.
# This means HyperPixel, vc4-kms-v3d, etc. are all silently ignored.
CONFIG_OF_OVERLAY=y
CONFIG_OF_DYNAMIC=y

# ── DRM / Display ──
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# ── Sound ──
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC_GENERIC_DMAENGINE_PCM=y
CONFIG_SND_SOC_HDMI_CODEC=y

# ── I2C (needed for touch via i2c-gpio) ──
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2835=y
CONFIG_I2C_GPIO=y

# ── Touchscreen ──
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

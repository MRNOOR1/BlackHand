# Black Hand OS — HyperPixel 4.0 kernel fragment (firmware DPI framebuffer)
#
# KMS overlay has a circular dependency on kernel 6.6, so we use the
# firmware-provided framebuffer (bcm2708_fb) instead of DRM/VC4.

# ── Firmware framebuffer ──
CONFIG_FB=y
CONFIG_FB_BCM2708=y

# ── Framebuffer console (login prompt on display) ──
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# ── devtmpfs (creates /dev/fb0 automatically) ──
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── GPIO sysfs (needed by hyperpixel4-init for SPI bit-bang) ──
CONFIG_GPIO_SYSFS=y
CONFIG_GPIOLIB=y

# ── VFAT support (mount boot partition) ──
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Black Hand OS — HyperPixel 4.0 kernel fragment
#
# Display: firmware DPI framebuffer (bcm2708_fb), no KMS/DRM
# Touch:   Goodix GT911 via I2C-GPIO (bit-banged on pins 10/11)

# ── Firmware framebuffer ──
CONFIG_FB=y
CONFIG_FB_BCM2708=y

# ── Framebuffer console ──
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# ── devtmpfs (creates /dev/fb0, /dev/input/event* automatically) ──
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── GPIO ──
CONFIG_GPIO_SYSFS=y
CONFIG_GPIOLIB=y

# ── I2C (for Goodix touch via i2c-gpio bit-bang on pins 10/11) ──
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y

# ── Input subsystem ──
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# ── Touchscreen (Goodix GT911 on HyperPixel 4.0) ──
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# ── VFAT support (mount boot partition) ──
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ── Audio ──
#
# Three layers are needed for ALSA to work end-to-end:
#
#   1. Core ALSA subsystem (SND, SND_PCM, SND_TIMER)
#      SND       — the main ALSA kernel framework
#      SND_PCM   — PCM device support; snd_pcm_open() needs this
#      SND_TIMER — high-resolution timer ALSA uses internally for
#                  scheduling audio callbacks; without it PCM devices
#                  may fail to open or stutter
#
#   2. Mixer support
#      SND_MIXER_OSS — exposes /dev/mixer so snd_mixer_open() works
#
#   3. Hardware drivers
#      SND_BCM2835   — Pi 4 onboard audio (3.5mm jack + HDMI audio)
#      SND_USB_AUDIO — USB audio adapters; Pi 4's onboard DAC is low
#                      quality, USB adapters are common in practice
#
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_BCM2835=y
CONFIG_SND_USB_AUDIO=y

# ── Bluetooth ──
#
# BT core + RFCOMM (serial over BT, needed for HFP signalling)
# SCO = Synchronous Connection Oriented — the audio channel HFP uses for
# mic and earpiece. Without it, HFP pairs but audio never flows.
#
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_SCO=y
CONFIG_BT_HS=y
CONFIG_BT_LE=y

# UART driver for the onboard BCM43455 chip.
# The chip is wired to /dev/ttyAMA0 at 3 Mbps.
# BCM sub-driver handles the firmware download sequence at attach time.
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_H4=y

# rfkill — lets you block/unblock the radio at runtime.
# "rfkill unblock bluetooth" in rcS brings the chip out of soft-block.
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

# CMAC (Cipher-based Message Authentication Code)
# Required by bluetoothd for BLE security context initialization.
# Without this, bluetoothd logs "Unable to create CMAC crypto context"
# and exits immediately after registering hci0.
CONFIG_CRYPTO_CMAC=y
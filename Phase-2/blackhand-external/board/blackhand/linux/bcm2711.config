# Black Hand OS — Waveshare 1.83" SPI panel kernel fragment
#
# Display: ST7789/NV3030B over SPI, driven by DRM panel-mipi-dbi (KMS),
#          fbdev emulation gives fbcon a /dev/fb0. Replaces the old
#          HyperPixel 4.0 firmware DPI framebuffer + Goodix touch stack.
# Touch:   NOT USED (panel ribbon is non-touch; all TP_* pins unconnected).
#
# NOTE (§8.1): this fragment is MERGED onto bcm2711_defconfig. Deleting a line
# does NOT unset the option — anything that must be OFF needs an explicit
# "# CONFIG_X is not set" so it overrides the base defconfig.

# ── Firmware framebuffers — MUST be off ────────────────────────────────────
# Both are =y in the base defconfig. If either survives it registers fb0
# first, fbcon binds to it, and the SPI panel becomes fb1 with no console
# (a black screen that looks exactly like a driver failure). With both off
# the SPI panel is the only framebuffer and fbcon takes it over automatically;
# no fbcon=map: is needed. (§5.2, pitfall §8.1)
# CONFIG_FB_BCM2708 is not set
# CONFIG_FB_SIMPLE is not set

# ── Framebuffer core + console ─────────────────────────────────────────────
# DRM_FBDEV_EMULATION needs the fbdev core (CONFIG_FB) to expose /dev/fb0.
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# ── devtmpfs (creates /dev/fb0, /dev/spidev*, etc. automatically) ──
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── GPIO (RST/DC lines + gpio-backlight) ──
CONFIG_GPIO_SYSFS=y
CONFIG_GPIOLIB=y

# ── SPI — the panel transport (+ RFM95 LoRa radio) ─────────────────────────
# The display owns SPI0 CE0 (spi0.0, mipi-dbi-spi, write-only). The RFM95W
# CM4 carrier: the display moved to SPI4 and SPI0 is restricted to one chip
# select (dtoverlay=spi0-1cs), because GPIO7 — normally SPI0 CE1 — is reused
# as SPI4's clock. The LoRa radio therefore owns SPI0 CE0 → /dev/spidev0.0.
# SPI_BCM2835 serves both SPI0 and SPI4 (same IP block). SPI_SPIDEV exposes
# that char device so the blackhand-lora userspace daemon can drive the
# SX1276 directly (there is no in-tree Linux LoRa driver). dtparam=spi=on in
# config.txt already enables both spidev children; the panel overlay only
# the panel on SPI4, leaving spidev0.0 (SPI0 CE0) for the radio.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_BCM2835=y
CONFIG_SPI_SPIDEV=y

# ── DRM / KMS stack for panel-mipi-dbi ─────────────────────────────────────
# Name every helper EXPLICITLY rather than relying on DRM_PANEL_MIPI_DBI's
# `select`: a select from a tristate can resolve to =m and reintroduce a
# module dependency chain. All are built-in (=y) so the driver probes before
# rootfs is mounted; the init blob is embedded via CONFIG_EXTRA_FIRMWARE
# below (a built-in driver's request_firmware() cannot wait for the rootfs).
# (§5.2, §5.3)
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_MIPI_DBI=y
CONFIG_DRM_PANEL_MIPI_DBI=y
CONFIG_DRM_FBDEV_EMULATION=y

# ── Backlight — gpio-backlight on BCM 18 ───────────────────────────────────
# BACKLIGHT_GPIO (gpio-backlight), NOT pwm-backlight. gpio-backlight does not
# touch the PWM block, so onboard headphone audio is unaffected. (§3, §5.2)
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y

# ── Firmware loader (panel-mipi-dbi loads panel.bin) ──
CONFIG_FW_LOADER=y

# ── Built-in panel init blob ───────────────────────────────────────────────
# A built-in driver probes before the rootfs is mounted, so the init sequence
# must be linked into the kernel. EXTRA_FIRMWARE_DIR has no leading '/', so it
# resolves against $(srctree): the buildroot agent's LINUX_PRE_BUILD_HOOK
# copies the blob to $(LINUX_DIR)/firmware/panel.bin before the build. (§5.3)
# BCM4345C0.hcd is embedded too: hci_uart_bcm is built-in and requests its
# patch at ~2.0s, but the rootfs (where /lib/firmware lives) is not mounted
# until ~3.0s -- the request always failed and the BT chip ran UNPATCHED
# ("firmware Patch file not found" in dmesg), which destabilises A2DP.
CONFIG_EXTRA_FIRMWARE="panel.bin brcm/BCM4345C0.hcd"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# ── Touch — CST816D capacitive controller on hardware I2C1 (GPIO2/3) ────────
# The old HyperPixel bit-banged bus (I2C_GPIO) and GT911 driver are gone —
# disable them explicitly (both are =y in the base defconfig). The CST816D
# talks over the Pi's hardware I2C (I2C_BCM2835); I2C_CHARDEV exposes
# /dev/i2c-1 for i2cdetect and a userspace touch reader. NOTE: this kernel has
# no in-tree CST816 driver (hynitron_cstxxx only matches cst340), so the touch
# driver is provided out-of-tree — see .claude/knowledge/architecture/.
# CONFIG_TOUCHSCREEN_GOODIX is not set
# CONFIG_I2C_GPIO is not set
CONFIG_I2C_BCM2835=y
CONFIG_I2C_CHARDEV=y

# ── VFAT support (mount boot partition) ──
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ── Audio ──
#
# Three layers are needed for ALSA to work end-to-end:
#
#   1. Core ALSA subsystem (SND, SND_PCM, SND_TIMER)
#      SND       — the main ALSA kernel framework
#      SND_PCM   — PCM device support; snd_pcm_open() needs this
#      SND_TIMER — high-resolution timer ALSA uses internally for
#                  scheduling audio callbacks; without it PCM devices
#                  may fail to open or stutter
#
#   2. Mixer support
#      SND_MIXER_OSS — exposes /dev/mixer so snd_mixer_open() works
#
#   3. Hardware drivers
#      SND_BCM2835   — Pi 4 onboard audio (3.5mm jack + HDMI audio)
#      SND_USB_AUDIO — USB audio adapters; Pi 4's onboard DAC is low
#                      quality, USB adapters are common in practice
#
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_BCM2835=y
CONFIG_SND_USB_AUDIO=y

# ── Bluetooth ──────────────────────────────────────────────────────────────
#
# Core BT subsystem + profiles:
#   BREDR  — Classic Bluetooth (A2DP, HFP, pairing)
#   RFCOMM — Serial over BT; HFP uses this for AT command signalling
#   SCO    — Synchronous audio channel; required for HFP mic/earpiece
#   LE     — Bluetooth Low Energy
#   HIDP   — BT HID (keyboards, mice, gamepads)
#   BNEP   — BT PAN (network over Bluetooth)
#
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_SCO=y
CONFIG_BT_HS=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_BT_BNEP=y

# ── Serial device bus (serdev) — REQUIRED for krnbt=on ──
# dtparam=krnbt=on in config.txt tells the RPi firmware to enable the
# kernel-managed BT attachment path. The kernel uses the serdev framework
# to bind the BCM43455 driver directly to /dev/ttyAMA0 (PL011 UART).
#
# Without these three options, serdev probe fails silently:
#   - hci0 never appears in /sys/class/bluetooth/
#   - bluetoothd starts but finds no adapter
#   - rfkill shows nothing to unblock
#
# SERIAL_DEV_BUS         — the serdev bus itself
# SERIAL_DEV_CTRL_TTYPORT— lets serdev bind to a standard ttyAMA0 port
# BT_HCIUART_SERDEV      — auto-selected when SERIAL_DEV_BUS + BT_HCIUART_BCM
#                          are both =y, but explicitly set here for clarity
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_H4=y

# ── SIM7600 cellular modem (USB serial AT ports) ──
# bcm2711_defconfig builds these as modules (=m), but our custom init has no
# module autoloading, so /dev/ttyUSB* never appeared (confirmed on hardware:
# lsusb saw 1e0e:9001 SimTech, zero ttyUSB ports, "module option not found").
# Building them in (=y) removes the dependency on modprobe/udev entirely.
#
# USB_SERIAL         — the USB serial core
# USB_SERIAL_WWAN    — shared layer for cellular modems (selected by OPTION,
#                      stated explicitly for clarity)
# USB_SERIAL_OPTION  — the driver that matches SimTech 1e0e:9001 and exposes
#                      the modem's interfaces as /dev/ttyUSB0..4 (AT port is
#                      usually USB2, sometimes USB3)
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_WWAN=y
CONFIG_USB_SERIAL_OPTION=y

# rfkill — lets you block/unblock the radio at runtime.
# "rfkill unblock bluetooth" in rcS brings the chip out of soft-block.
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

# ── Crypto — ALL required for Bluetooth security ────────────────────────
#
# CMAC + AES  — Classic BT: bluetoothd calls crypto_alloc_shash("cmac(aes)")
#               at startup. If either is missing, hci0 gets
#               "Unable to create CMAC crypto context" and bluetoothd exits.
#
# ECDH        — BLE Secure Connections pairing (phase 2 key exchange).
#               Without it, BLE devices refuse to pair with error
#               "Authentication Failed" or "Pairing not supported".
#
# SHA256      — BLE key derivation (f4, f5, f6 functions in the spec).
#
# CCM         — BLE link-layer encryption (AES-CCM cipher mode).
#               Without it, encrypted BLE connections drop immediately.
#
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_CCM=y

# ── Kernel modules must NOT be compressed ──────────────────────────────────
# bcm2711_defconfig sets CONFIG_MODULE_COMPRESS_XZ=y, which breaks module
# loading here: host depmod cannot index .ko.xz, busybox modprobe reports
# "not found", and busybox insmod cannot decompress it. Force plain .ko and
# explicitly clear every compressed variant (merge semantics, §8.1/§8.3).
CONFIG_MODULE_COMPRESS_NONE=y
# CONFIG_MODULE_COMPRESS_XZ is not set
# CONFIG_MODULE_COMPRESS_GZIP is not set
# CONFIG_MODULE_COMPRESS_ZSTD is not set

# ── Framebuffer console fonts ──────────────────────────────────────────────
# Panel is 240×280. VGA8x16 gives 240/8 = 30 cols × 280/16 = 17 rows (272px of
# 280 used → ~8px unlit strip at the bottom, covered by the UI/rcS side).
# Selected via fbcon=font:VGA8x16 in cmdline.txt. FONT_10x18 (24×15) and
# ProFont6x11 are kept as alternatives. (DISPLAY-SETUP-BRIEF.md §5.4, §6.1)
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_10x18=y
CONFIG_FONT_6x11=y

# Load all package makefiles from this external tree.
include $(sort $(wildcard $(BR2_EXTERNAL_BLACKHAND_PATH)/package/*/*.mk))

# ── SPI panel init blob for the built-in panel-mipi-dbi driver ───────────────
# The driver is built into the kernel (=y) via CONFIG_EXTRA_FIRMWARE="panel.bin"
# with CONFIG_EXTRA_FIRMWARE_DIR="firmware". A built-in driver probes before the
# rootfs is mounted, so request_firmware() cannot read /lib/firmware — the blob
# must be linked into the kernel image. The kernel resolves EXTRA_FIRMWARE_DIR
# (no leading /) against $(srctree), i.e. $(LINUX_DIR)/firmware. This pre-build
# hook stages the blob there before the kernel builds.
#
# Dependency: board/blackhand/overlay/lib/firmware/panel.bin (generated by the
# drivers agent from board/blackhand/panel/). If it is absent the kernel build
# fails fast, which is the intended signal that the blob was not generated.
define BLACKHAND_INSTALL_PANEL_FIRMWARE
	$(INSTALL) -D -m 0644 \
		$(BR2_EXTERNAL_BLACKHAND_PATH)/board/blackhand/overlay/lib/firmware/panel.bin \
		$(LINUX_DIR)/firmware/panel.bin
	$(INSTALL) -D -m 0644 \
		$(BR2_EXTERNAL_BLACKHAND_PATH)/board/blackhand/overlay/lib/firmware/brcm/BCM4345C0.hcd \
		$(LINUX_DIR)/firmware/brcm/BCM4345C0.hcd
endef
LINUX_PRE_BUILD_HOOKS += BLACKHAND_INSTALL_PANEL_FIRMWARE

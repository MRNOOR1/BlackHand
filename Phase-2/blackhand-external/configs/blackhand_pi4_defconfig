# ============================================================================
# BLACK HAND OS — Notcurses TUI on HyperPixel 4.0
# ============================================================================
# Framebuffer console + notcurses-based phone UI.
# ============================================================================

# Architecture
BR2_aarch64=y
BR2_cortex_a72=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_6=y
BR2_GCC_VERSION_14_X=y
BR2_BINUTILS_VERSION_2_45_X=y

# System
BR2_TARGET_GENERIC_HOSTNAME="blackhand"
BR2_TARGET_GENERIC_ISSUE="Black Hand OS"
BR2_TARGET_GENERIC_ROOT_PASSWD="blackhand"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# Keep busybox so /sbin/init, /bin/sh and standard tools are present.
# blackhand-init becomes PID 1 via init=/sbin/blackhand-init in cmdline.txt,
# not by replacing /sbin/init — that way verify-image.sh section 4 still passes.
BR2_INIT_BUSYBOX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/raspberrypi/linux/archive/refs/tags/stable_20241008.tar.gz"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b"
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BLACKHAND_PATH)/board/blackhand/linux/bcm2711.config"

# RPi firmware (required to boot)
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y

# Packages
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_KMOD=y

# Notcurses TUI dependencies (auto-selected, but explicit for clarity)
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_LIBUNISTRING=y
BR2_PACKAGE_LIBDEFLATE=y

# GPM — General Purpose Mouse daemon
# Required for touchscreen/mouse input on Linux framebuffer console.
# GPM reads /dev/input/event* and injects mouse escape sequences into
# the console, which notcurses then receives as NCKEY_BUTTON* events.
BR2_PACKAGE_GPM=y

# Notcurses TUI library (built with GPM support)
BR2_PACKAGE_NOTCURSES=y

# Black Hand OS packages
# Build order enforced by DEPENDENCIES fields in each .mk file:
#   blackhand-ipc → blackhand-audio, blackhand-storage, blackhand-modem, blackhand-ui
#   blackhand-init (PID 1 + service manager) has no blackhand dependencies
BR2_PACKAGE_BLACKHAND_IPC=y
BR2_PACKAGE_BLACKHAND_INIT=y
BR2_PACKAGE_BLACKHAND_AUDIO=y
BR2_PACKAGE_BLACKHAND_STORAGE=y
BR2_PACKAGE_BLACKHAND_MODEM=y

# ── Bluetooth firmware ───────────────────────────────────────────────────
# BCM4345C0.hcd and BCM4345C0.raspberrypi,4-model-b.hcd are included via
# board/blackhand/overlay/lib/firmware/brcm/ and fetched by post-build.sh.
# BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI* are NOT used — they are
# deprecated in current Buildroot and trigger BR2_LEGACY=y, aborting
# the build with "error: you have legacy config options set".
z
# ── Bluetooth ────────────────────────────────────────────────────────────
# D-Bus is a prerequisite for BlueZ — the daemon talks to bluetoothd
# entirely over D-Bus. Without it bluetoothd refuses to start.
BR2_PACKAGE_DBUS=y

# BlueZ 5 — the standard Linux BT stack
# CLIENT        = bluetoothctl CLI tool (used by bluetooth_service.c)
# DEPRECATED    = hciconfig, hcitool, hcidump — essential for debugging
# PLUGINS_AUDIO = A2DP and HFP/HSP profile plugins inside bluetoothd
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y

# bluez-alsa — bridges BT audio to ALSA without PulseAudio.
# Runs as "bluealsa" daemon. When a BT device is connected with A2DP,
# it appears as an ALSA PCM device you can put in asound.conf.
BR2_PACKAGE_BLUEZ_ALSA=y

# bluez-tools — provides bt-agent for headless BT pairing.
# bt-agent -c NoInputNoOutput registers a "Just Works" pairing agent
# with bluetoothd. Without a registered agent, ALL pairing attempts
# are rejected with "No agent is registered".
BR2_PACKAGE_BLUEZ_TOOLS=y

# Black Hand UI (notcurses TUI app)
BR2_PACKAGE_BLACKHAND_UI=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ARECORD=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# HyperPixel panel init (SPI bit-bang to wake LCD controller)
# NOTE: The vc4-kms-dpi-hyperpixel4 overlay handles panel init via
# kernel SPI-GPIO, so this may be redundant. Kept as fallback.
BR2_PACKAGE_HYPERPIXEL4_INIT=y

# Debug tools (remove before final image)
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_RFKILL=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"

# Host tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Board customization
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BLACKHAND_PATH)/board/blackhand/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BLACKHAND_PATH)/board/blackhand/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BLACKHAND_PATH)/board/blackhand/post-image.sh"

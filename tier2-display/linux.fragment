# Tier 2 kernel options: SPI panel via panel-mipi-dbi, fbdev console on it.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_BCM2835=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_MIPI_DBI=y
CONFIG_DRM_PANEL_MIPI_DBI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
# The driver is built in, so its init blob must be linked into the kernel
# (generated by blackhand-panel, see blackhand-panel.mk).
CONFIG_EXTRA_FIRMWARE="panel.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
# fbcon=font:VGA8x16 in cmdline.txt
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

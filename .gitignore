# ── Compiled build artifacts ─────────────────────────────────────────
*.img
*.o
*.a
*.so
*.d
*.elf
*.bin
*.hex
*.map
*.lst

# Compiled device tree overlays (generated from .dts source by post-build.sh)
# Never commit .dtbo — they are binary build outputs, not source files.
*.dtbo

# ── Build directories ─────────────────────────────────────────────────
Phase-1/build/
output/
buildroot/

# ── IDE / editor configs (user-specific, not part of the project) ─────
.vscode/
.idea/
*.code-workspace

# ── Claude / AI tool local settings ──────────────────────────────────
.claude/

# ── macOS metadata ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Documents / generated reports ────────────────────────────────────

# The panel init blob is a build INPUT, not an artifact: the kernel's
# panel-mipi-dbi driver loads it from /lib/firmware/panel.bin at probe time
# and the display stays dark without it. The blanket *.bin rule above would
# otherwise drop it from the repo, so a fresh clone would build a dark image.
# Regenerate with board/blackhand/panel/mkpanelbin.py after editing panel.txt.
!Phase-2/blackhand-external/board/blackhand/overlay/lib/firmware/panel.bin

# Buildroot source-tarball cache (see Phase-2/setup.sh)
Phase-2/dl/
